  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WizardMD.Core\WizardMD.Core.csproj" />
  </ItemGroup>

</Project>
